{
  "schema": 1,
  "id": "corsair.virtuoso",
  "version": "0.2.0",
  "name": "Corsair Virtuoso",
  "category": "headset",
  "image": "images/virtuoso.png",
  "battery": {"level": "battery", "charging": "charging"},
  "available": {"state": "link", "values": ["online", "wired"]},
  "display_name": [
    {"match": "corsair virtuoso {model:upper} *", "format": "Corsair Virtuoso {model}"},
    {"match": "corsair virtuoso *", "format": "Corsair Virtuoso"}
  ],
  "match": [
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a3e", "paired": true, "connection": "wireless"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a3f", "paired": true, "connection": "wireless"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a42", "paired": true, "connection": "wireless"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a4a", "paired": true, "connection": "wireless"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a63", "paired": true, "connection": "wireless"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a3d", "connection": "cable"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a41", "connection": "cable"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a49", "connection": "cable"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a62", "connection": "cable"}
  ],
  "channel": {"type": "hid", "interface": [4, 3], "report_size": 65},
  "driver": {
    "type": "corsair-v2w",
    "version": ">=0.2,<1",
    "provided_by": "borochid-driver-corsair-v2w"
  },
  "audio": {"match": ["corsair", "virtuoso"]},
  "summary": {
    "state": "link",
    "map": {"online": "Connected", "wired": "USB cable"}
  },

  "v2w": {
    "links": {
      "wireless": ["0x0a3e", "0x0a3f", "0x0a42", "0x0a4a", "0x0a63"],
      "wired": ["0x0a3d", "0x0a41", "0x0a49", "0x0a62"]
    },
    "features": {
      "lighting": {
        "zones": [
          {"id": "logo", "kind": "color", "label": "Logo", "default": "#ff0000"},
          {"id": "battery", "kind": "battery"},
          {"id": "mic", "kind": "mic", "label": "Microphone", "default": "#ff0000", "muted_default": "#ff0000"}
        ]
      },
      "battery": {"poll_s": 1800, "low_percent": 15, "samples": 3},
      "mic_button": {}
    }
  },

  "ui": [
    {"widget": "group", "label": "Lighting", "icon": ["brightness-high", "display-brightness-symbolic", "games-hint"], "enabled_if": "online", "children": [
      {"widget": "row", "label": "Logo", "children": [
        {"widget": "color", "tooltip": "Logo color", "state": "logo_color", "action": "set_logo_color", "param": "value"},
        {"widget": "slider", "tooltip": "Logo brightness", "icon": ["brightness-high", "display-brightness-symbolic"],
         "min": 0, "max": 100, "state": "logo_brightness", "action": "set_logo_brightness", "param": "value"}
      ]},
      {"widget": "row", "label": "Microphone", "children": [
        {"widget": "color", "tooltip": "Microphone color", "state": "mic_color", "action": "set_mic_color", "param": "value"},
        {"widget": "slider", "tooltip": "Microphone brightness", "icon": ["brightness-high", "display-brightness-symbolic"],
         "min": 0, "max": 100, "state": "mic_brightness", "action": "set_mic_brightness", "param": "value"}
      ]},
      {"widget": "color", "label": "When muted", "tooltip": "Microphone color while muted", "state": "mic_muted_color", "action": "set_mic_muted_color", "param": "value"}
    ]},
    {"widget": "group", "label": "Audio", "icon": ["audio-volume-high", "audio-volume-high-symbolic"], "children": [
      {"widget": "slider", "label": "Volume", "min": 0, "max": 100, "state": "audio.volume", "action": "audio.set_volume", "param": "value"},
      {"widget": "readout", "label": "Microphone", "state": "audio.mic_muted",
       "icon": {"map": {"true": ["microphone-sensitivity-muted", "microphone-sensitivity-muted-symbolic"],
                        "false": ["microphone-sensitivity-high", "microphone-sensitivity-high-symbolic"]}},
       "map": {"true": "Muted", "false": "Live", "null": "—"}},
      {"widget": "toggle", "label": "Mute feedback tone", "state": "audio.mute_tone", "action": "audio.set_mute_tone", "param": "value"},
      {"widget": "slider", "label": "Sidetone", "min": 0, "max": 100, "state": "audio.sidetone", "action": "audio.set_sidetone", "param": "value"},
      {"widget": "toggle", "label": "Sidetone off on exit", "state": "audio.sidetone_off_on_exit", "action": "audio.set_sidetone_off_on_exit", "param": "value"}
    ]}
  ]
}
