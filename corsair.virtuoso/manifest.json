{
  "schema": 1,
  "id": "corsair.virtuoso",
  "version": "0.1.0",
  "name": "Corsair Virtuoso",
  "display_name": [
    {"match": "corsair virtuoso {model:upper} *", "format": "Corsair Virtuoso {model}"},
    {"match": "corsair virtuoso *", "format": "Corsair Virtuoso"}
  ],
  "match": [
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a3e"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a3f"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a42"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a4a"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a63"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a3d"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a41"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a49"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a62"},
    {"bus": "usb", "vid": "0x1b1c", "pid": "0x0a46", "channel": null}
  ],
  "channel": {"type": "hid", "interface": [4, 3], "report_size": 65},
  "driver": {
    "type": "corsair-v2w",
    "version": ">=0.1,<1",
    "provided_by": "borochid-driver-corsair-v2w"
  },
  "audio": {"match": ["corsair", "virtuoso"]},
  "summary": {
    "state": "link",
    "map": {"online": "Connected", "offline": "Headset not answering", "standby": "Headset off", "wired": "USB cable"}
  },

  "v2w": {
    "links": {
      "wireless": ["0x0a3e", "0x0a3f", "0x0a42", "0x0a4a", "0x0a63"],
      "wired": ["0x0a3d", "0x0a41", "0x0a49", "0x0a62"],
      "standby": ["0x0a46"]
    },
    "receiver_software_mode": false,
    "keepalive_s": 20,
    "probe_s": 10,
    "probe_max_s": 600,
    "features": {
      "lighting": {
        "zones": [
          {"id": "logo", "kind": "color", "label": "Logo", "default": "#ff0000"},
          {"id": "battery", "kind": "battery"},
          {"id": "mic", "kind": "mic", "label": "Microphone", "default": "#ff0000", "muted_default": "#ff0000"}
        ]
      },
      "battery": {"poll_s": 1800, "low_percent": 15, "samples": 3},
      "sidetone": {},
      "mic_button": {}
    }
  },

  "ui": [
    {"widget": "group", "label": "Status", "children": [
      {"widget": "readout", "label": "Headset", "state": "link",
       "map": {"online": "Connected", "offline": "Not answering", "standby": "Switched off", "wired": "USB cable"}},
      {"widget": "readout", "label": "Battery", "state": "battery", "suffix": "%", "map": {"null": "—"}},
      {"widget": "readout", "label": "Power", "state": "charging",
       "map": {"true": "Charging", "false": "On battery", "null": "—"}},
      {"widget": "button", "label": "", "text": "Refresh battery", "action": "refresh_battery", "enabled_if": "online"}
    ]},
    {"widget": "group", "label": "Lighting", "enabled_if": "wireless", "children": [
      {"widget": "color", "label": "Logo", "state": "logo_color", "action": "set_logo_color", "param": "value"},
      {"widget": "slider", "label": "Logo brightness", "min": 0, "max": 100, "state": "logo_brightness", "action": "set_logo_brightness", "param": "value"},
      {"widget": "color", "label": "Microphone", "state": "mic_color", "action": "set_mic_color", "param": "value"},
      {"widget": "slider", "label": "Mic brightness", "min": 0, "max": 100, "state": "mic_brightness", "action": "set_mic_brightness", "param": "value"},
      {"widget": "color", "label": "Mic when muted", "state": "mic_muted_color", "action": "set_mic_muted_color", "param": "value"}
    ]},
    {"widget": "group", "label": "Microphone", "children": [
      {"widget": "readout", "label": "State", "state": "audio.mic_muted",
       "map": {"true": "Muted", "false": "Live", "null": "—"}},
      {"widget": "button", "label": "", "text": "Toggle mute", "action": "audio.toggle_mic_mute"},
      {"widget": "toggle", "label": "Feedback tone", "state": "audio.mute_tone", "action": "audio.set_mute_tone", "param": "value"}
    ]},
    {"widget": "group", "label": "Audio", "children": [
      {"widget": "slider", "label": "Volume", "min": 0, "max": 100, "state": "audio.volume", "action": "audio.set_volume", "param": "value"},
      {"widget": "slider", "label": "Sidetone", "min": 0, "max": 100, "state": "audio.sidetone", "action": "audio.set_sidetone", "param": "value"},
      {"widget": "toggle", "label": "Sidetone off on exit", "state": "audio.sidetone_off_on_exit", "action": "audio.set_sidetone_off_on_exit", "param": "value"}
    ]},
    {"widget": "group", "label": "Headset sidetone (bypasses the sound card)", "enabled_if": "sidetone_supported", "children": [
      {"widget": "slider", "label": "Level", "min": 0, "max": 100, "state": "sidetone", "action": "set_sidetone", "param": "value"},
      {"widget": "toggle", "label": "Off on exit", "state": "sidetone_off_on_exit", "action": "set_sidetone_off_on_exit", "param": "value"}
    ]}
  ]
}
